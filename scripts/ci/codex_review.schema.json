{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "head",
    "patchSha256",
    "risk",
    "evidence"
  ],
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "PASS",
        "CHANGES_REQUIRED",
        "HUMAN_REVIEW_REQUIRED",
        "BLOCKED"
      ]
    },
    "head": {
      "type": "string"
    },
    "patchSha256": {
      "type": "string"
    },
    "risk": {
      "type": "string",
      "enum": [
        "LOW",
        "MEDIUM",
        "HIGH"
      ]
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "line",
          "quote",
          "reason",
          "tests",
          "confidence"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "line": {
            "type": "integer",
            "minimum": 1
          },
          "quote": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "tests": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "confidence": {
            "type": "string",
            "enum": [
              "CONFIRMED",
              "UNVERIFIED"
            ]
          }
        }
      }
    }
  }
}
